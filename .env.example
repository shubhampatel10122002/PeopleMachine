# --- Tavus ---------------------------------------------------------------
# From the Tavus dashboard. Server-side only, never exposed to the browser.
TAVUS_API_KEY=

# Maya — Civil Rights Intake Specialist. Defaults are baked into the code,
# so these are only needed to point at a different PAL or face.
TAVUS_PAL_ID=p7ac55cbadb2
TAVUS_FACE_ID=ra3a03647d46

# Shared secret appended to every callback_url we hand Tavus. Any long random
# string; the same value must be in the objective callback URLs in Tavus.
# Generate one with: openssl rand -hex 32
TAVUS_WEBHOOK_SECRET=

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://eeytqmshggwyrchixdal.supabase.co

# Settings → API Keys → service_role. Bypasses RLS, so server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -----------------------------------------------------------------
# Public origin, used to build the Tavus callback URL. Set this explicitly in
# production so webhooks never point at a per-deploy preview URL.
PUBLIC_BASE_URL=https://your-domain.vercel.app

# Single shared password for /admin. No accounts, no signup.
ADMIN_PASSWORD=
