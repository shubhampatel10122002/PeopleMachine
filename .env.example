# --- Tavus ---------------------------------------------------------------
# From the Tavus dashboard. Server-side only, never exposed to the browser.
TAVUS_API_KEY=dde3fd18c9c349adb82e00a83bbbdee8

# The agent. Production sets this explicitly; the fallback in src/lib/env.ts is
# other PAL (p93c8a932419). Both PALs carry the same prompt and objective tree;
# edit them together. See tavus/README.md.
TAVUS_PAL_ID=p7ac55cbadb2

# There is no TAVUS_FACE_ID, on purpose. The face comes from the PAL's
# default_face_id in PAL Maker and nowhere else. It used to be set here, and
# because a face_id sent at conversation-create time overrides the PAL, editing
# the face in PAL Maker silently did nothing. If your Vercel project still has
# TAVUS_FACE_ID set, it is inert now — delete it.

# Shared secret appended to every callback_url we hand Tavus. Any long random
# string; the same value must be in the objective callback URLs in Tavus.
# Generate one with: openssl rand -hex 32
TAVUS_WEBHOOK_SECRET=

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://eeytqmshggwyrchixdal.supabase.co

# Settings → API Keys → service_role. Bypasses RLS, so server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -----------------------------------------------------------------
# Public origin, used to build the Tavus callback URL. Set this explicitly, and
# only ever to an origin that actually resolves to this app — if Tavus cannot
# reach it, every conversation callback is lost silently and intakes stay stuck
# at in_progress with no transcript. Do not point it at a custom domain until
# that domain's DNS is really serving Vercel.
PUBLIC_BASE_URL=https://people-machine.vercel.app

# Single shared password for /admin. No accounts, no signup.
ADMIN_PASSWORD=
